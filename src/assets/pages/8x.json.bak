  "headlightBlock": {
    "image": "info3.webp",
    "title": {
      "ua": "Зіркова діамантова матриця фар",
      "en": "Star Diamond Matrix Headlights"
    },
    "features": [
      {
        "ua": "Широка смуга освітлення — горизонтальна естетика неба і землі",
        "en": "Wide light strip — horizontal aesthetic of sky and earth"
      },
      {
        "ua": "25 368 діамантових граней у відбивачі",
        "en": "25,368 diamond-shaped facets in the reflector"
      },
      {
        "ua": "Дифузне розсіювання у зустрічному світлі — наче сяюча Чумацька мить",
        "en": "Diffuse reflection in light — like a brilliant starry galaxy"
      }
    ],
    "textRight": false
  },
  "taillightBlock": {
    "image": "info5.webp",
    "title": {
      "ua": "Задні ліхтарі — лінія узбережжя",
      "en": "Coastline Running Tail Lights"
    },
    "features": [
      {
        "ua": "54 894 діамантові грані, що збираються у переливчасте узбережжя",
        "en": "54,894 diamond facets forming a shimmering coastline"
      },
      {
        "ua": "Технологія 630 нм надчервоного світла — чітко видима за будь-яких погодних умов",
        "en": "630nm ultra-red technology — clearly visible in any weather"
      }
    ],
    "textRight": true
  },
  "projectionHeadlightBlock": {
    "image": "info4.webp",
    "title": {
      "ua": "Інтелектуальні HD-проекційні фари",
      "en": "Intelligent HD Projection Headlights"
    },
    "features": [
      {
        "ua": "Не лише освітлюють дорогу, а й вміють «спілкуватися»",
        "en": "Not only illuminates the road, but also communicates"
      },
      {
        "ua": "Світловий килим 2,4 м охоплює навіть широкий кузов",
        "en": "2.4m light carpet covers even the wide body"
      }
    ],
    "textRight": false
  },
  "rearDesignBlock": {
    "topTitle": {
      "ua": "Потужний характер ззаду",
      "en": "Powerful Character, Revealed at the Rear"
    },
    "images": ["info2.webp"],
    "items": [
      {
        "title": {
          "ua": "Широкий приземистий дизайн задньої частини",
          "en": "Wide-Body Low-Profile Rear Design"
        },
        "description": {
          "ua": "Співвідношення ширини до висоти 1:1,2 забезпечує приземисту поставу спортивного автомобіля — один лише силует ззаду вже передає стрімку енергію",
          "en": "A 1:1.2 width-to-height ratio achieves the low-slung stance of a high-performance car — one rear silhouette alone radiates surging dynamism"
        }
      }
    ]
  },
  "textBlockDesign": {
    "title": {
      "ua": "Пізнай безкраї простори. Живи вільно",
      "en": "Powerful Elegance"
    },
    "subtitle": {
      "ua": "Естетика флагмана продуктивності",
      "en": "Performance Flagship Aesthetics"
    }
  },
  "textBlockCockpit": {
    "title": {
      "ua": "За кермом і в салоні — кожному свій рай",
      "en": "Drive in Pleasure, Ride in Bliss"
    },
    "subtitle": {
      "ua": "",
      "en": ""
    }
  },
  "cockpitBlock": {
    "image1": "inside2.webp",
    "image2": "inside1.webp",
    "version1": {
      "title": {
        "ua": "Кокпіт-кабіна водія",
        "en": "Cockpit Driver Front Row"
      },
      "specs": [
        {
          "value": {
            "ua": "Обгортаюча кокпіт-кабіна",
            "en": "Enveloping Cockpit"
          },
          "label": {
            "ua": "Центрована на водії — обгортаюче компонування формує точний зв'язок між людиною та автомобілем",
            "en": "Driver-centered design — the wraparound layout creates a precise connection between driver and vehicle"
          }
        },
        {
          "value": {
            "ua": "Крісло-флагман з довгим ходом",
            "en": "Long-Range Comfort Throne"
          },
          "label": {
            "ua": "Активна поперекова підтримка, рідинна накачка за 0,1 с, повна накачка за 1,8 с, авторегулювання подушки та підставки для ніг, хід до 80 мм",
            "en": "Active lumbar support, liquid inflation in 0.1s, full inflation in 1.8s, auto-adjusting cushion and leg rest with 80mm travel range"
          }
        },
        {
          "value": {
            "ua": "Багаторівневе компонування кабіни",
            "en": "Split-Level Cockpit Layout"
          },
          "label": {
            "ua": "Платформа водія, приладова панель та центральна консоль утворюють єдину замкнену кабіну для зручного керування",
            "en": "The driver's platform, instruments, and center console form a unified sealed cockpit for intuitive control"
          }
        }
      ]
    },
    "version2": {
      "title": {
        "ua": "Розкішний задній ряд рівня MPV",
        "en": "Luxury MPV-Class Second Row"
      },
      "note": {
        "ua": "Ширше за аналоги — насолода простором без меж",
        "en": "Wider than its class — unlimited freedom to stretch"
      },
      "specs": [
        {
          "value": {
            "ua": "Вільно витягнутися — і ногам комфортно",
            "en": "Stretch Freely — Legs Fully at Rest"
          },
          "label": {
            "ua": "999 мм простору для ніг, 267 мм глибини підколінного простору",
            "en": "999mm of leg space, 267mm of knee clearance"
          }
        },
        {
          "value": {
            "ua": "Подвійний складний столик",
            "en": "Dual Tray Table Design"
          },
          "label": {
            "ua": "Компактна робоча поверхня, витримує до 15 кг",
            "en": "Space-saving work surface, supports up to 15kg"
          }
        },
        {
          "value": {
            "ua": "Хід ковзання до 150 мм",
            "en": "150mm Maximum Slide Travel"
          },
          "label": {
            "ua": "Все необхідне — під рукою, де б ви не знаходились",
            "en": "Everything within reach, wherever you are"
          }
        },
        {
          "value": {
            "ua": "Режим гостинності",
            "en": "Welcome Mode"
          },
          "label": {
            "ua": "Зручна посадка та висадка для задніх пасажирів",
            "en": "Easy entry and exit for rear passengers"
          }
        }
      ]
    }
  }
}
