  "hero": {
    "title": {
      "ua": "ZEEKR 8X",
      "en": "ZEEKR 8X"
    },
    "subtitle": {
      "ua": "Суперпотужний гібридний флагманський позашляховик",
      "en": "Super Hybrid High-Performance Flagship SUV"
    },
    "video": "hero_8x.mp4",
    "buttons": [
      {
        "text": {
          "ua": "Замовити зараз",
          "en": "Order Now"
        },
        "type": "order",
        "style": "white"
      },
      {
        "text": {
          "ua": "Технічні характеристики",
          "en": "Technical Specifications"
        },
        "type": "scroll_to",
        "target": "techSpecsBlock",
        "style": "transparent"
      }
    ]
    
  },
  "dimensionsBlock": {
    "image": {
      "desktop": "size.webp",
      "tablet": "size.webp",
      "mobile": "size.webp"
    },
    "specs": [
      {
        "value": "0.618",
        "label": {
          "ua": "Золоте співвідношення пропорцій кузова",
          "en": "Golden body proportion ratio"
        }
      },
      {
        "value": "1:4",
        "label": {
          "ua": "Співвідношення колеса до осі",
          "en": "Wheel-to-axle ratio"
        }
      }
    ]
  },
  "exteriorDesignBlock": {
    "topTitle": {
      "ua": "Безліч ліній — єдиний силует",
      "en": "All Lines, One Silhouette"
    },
    "images": ["info1.webp", "info1.webp", "info1.webp", "info1.webp", "info1.webp"],
    "items": [
      {
        "title": {
          "ua": "Обтічна лінія даху",
          "en": "Gulf Stream Roofline"
        },
        "description": {
          "ua": "Від задньої частини до передньої, від широкої до стрункої — наче потужна течія Гольфстриму, що надає силуету плавності та динаміки",
          "en": "Tapering from rear to front like a powerful Gulf Stream, sculpting a fluid and dynamic silhouette"
        }
      },
      {
        "title": {
          "ua": "Плечова лінія-хвиля",
          "en": "Surge Shoulder Line"
        },
        "description": {
          "ua": "Від задніх ліхтарів вперед, ніжно обтікаючи стійку B, наче гребінь хвилі, — окреслює парящу красу вікон",
          "en": "Flowing forward from the taillights, gently passing the B-pillar like a cresting wave, tracing the floating beauty of the windows"
        }
      },
      {
        "title": {
          "ua": "Поясна лінія фіорду",
          "en": "Fjord Surge Waistline"
        },
        "description": {
          "ua": "Рельєфне ребро наче скандинавський фіорд — стрімке в русі, безтурботно гладке у спокої, розкриваючи красу силуету",
          "en": "The bold ridge line evokes a Nordic fjord — poised to surge, yet serene as a calm lake, revealing the sculpted beauty of the profile"
        }
      },
      {
        "title": {
          "ua": "Дзеркальні двері без зазорів",
          "en": "Zero-Gap Mirror Door"
        },
        "description": {
          "ua": "Скло врівень із дверною рамкою — як єдине дзеркало, де естетика поєднується з мінімальним аеродинамічним опором",
          "en": "Glass flush with the door frame — like a seamless mirror, combining aesthetics with minimal aerodynamic drag"
        }
      },
      {
        "title": {
          "ua": "Розумна ручка з подвійним захистом",
          "en": "Smart Electric Dual-Safety Door Handle"
        },
        "description": {
          "ua": "Інтелектуальне відкривання для зручності, механічний замок — для надійності",
          "en": "Smart opening and closing for convenience, mechanical safety lock for reliability"
        }
      }
    ]
  },
