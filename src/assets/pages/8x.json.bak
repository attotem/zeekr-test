    "options": [
      {
        "id": "white_inside",
        "name": {
          "ua": "Біло-чорний",
          "en": "White & Black"
        },
        "image": {
          "desktop": "white_inside.webp",
          "tablet": "white_inside.webp",
          "mobile": "white_inside.webp"
        },
        "description": {
          "ua": "Розкіш, що вміє «дихати» — простір сповнений повітря і ритму",
          "en": "Luxury that understands space — the interior breathes with rhythm"
        }
      },
      {
        "id": "brown_inside",
        "name": {
          "ua": "Коричнево-чорний",
          "en": "Brown & Black"
        },
        "image": {
          "desktop": "brown_inside.webp",
          "tablet": "brown_inside.webp",
          "mobile": "brown_inside.webp"
        },
        "description": {
          "ua": "Як досвідчений джентльмен — наповнює простір відчутною, майже дотиковою довірою",
          "en": "Like a seasoned gentleman — filling the space with a trust you can almost touch"
        }
      },
      {
        "id": "red_inside",
        "name": {
          "ua": "Червоний відблиск",
          "en": "Red Shadow"
        },
        "image": {
          "desktop": "red_inside.webp",
          "tablet": "red_inside.webp",
          "mobile": "red_inside.webp"
        },
        "description": {
          "ua": "Пристрасний і глибокий — наче слід червоного скакуна, де тінь слідує за серцем",
          "en": "Passionate and deep — like the trail of a galloping red steed, where shadow follows the heart"
        }
      },
      {
        "id": "gray_inisde",
        "name": {
          "ua": "Чистий чорний",
          "en": "Pure Black"
        },
        "image": {
          "desktop": "black_inside.webp",
          "tablet": "black_inside.webp",
          "mobile": "black_inside.webp"
